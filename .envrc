#!/usr/bin/env bash

dotenv_if_exists .env

export REPO_ROOT="$(git rev-parse --show-toplevel)"

# Use a repo-local data dir instead of the real ~/.job-scraper so local dev
# never gets shadowed by (or pollutes) the global registry — especially
# useful when the registry's shape is changing and needs a fresh merge.
export JOB_SCRAPER_DATA_DIR="$REPO_ROOT/.data"
