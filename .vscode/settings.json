{
  "editor.codeActionsOnSave": {
    "source.organizeImports": "always",
    "source.addMissingImports.ts": "always",
    "source.fixAll.prettier": "always"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "files.exclude": {
    ".codegraph/": true,
    ".playwright-mcp/": true,
    ".remember/": true,
    "**/.astro/": true,
    "**/node_modules/": true,
    // files that likely won't be touched ever and just pollute files list
    ".mcp.json": true,
    ".prettierignore": true,
    ".prettierrc.cjs": true,
    ".shellcheckrc": true,
    "bun.lock": true,
    "bunfig.toml": true,
    "dist": true,
    "knip.json": true,
    "LICENSE": true,
    "site-dist": true,
    "tsconfig.tsbuildinfo": true
  },
  // make sure TS auto-imports have the file extension (required for node)
  "js/ts.preferences.importModuleSpecifierEnding": "js",
  "js/ts.preferences.organizeImports": {
    "caseSensitivity": "caseInsensitive",
    "typeOrder": "last"
  },
  "js/ts.tsdk.path": "node_modules/typescript",
  "js/ts.experimental.useTsgo": true
}
