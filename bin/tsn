#!/usr/bin/env bash

###
# A drop-in for running `node` that enables node to run TypeScript modules directly
###

volta="$HOME/.volta/bin/volta"
if [ -e "$volta" ]; then
  node="$($volta which node)"
else
  node="$(which node)"
fi

# `job-scraper-source` points the package's own `#platform` import at the
# TypeScript sources rather than `dist` (see `imports` in package.json)
$node --conditions=job-scraper-source --experimental-transform-types --no-warnings --env-file-if-exists=.env "${@}"
