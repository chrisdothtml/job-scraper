{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/platform/{node,browser}.ts",
    "src/**/*.test.ts",
    "src/scripts/*.ts",
    "site/main.ts",
    "site/snippets/*.ts"
  ],
  "project": ["src/**/*.ts", "site/**/*.ts"],
  "ignoreExportsUsedInFile": true,
  "tags": ["-@knipignore"]
}
