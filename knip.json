{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "tags": ["-@knipignore"],
  "workspaces": {
    ".": {
      "entry": [
        "src/platform/{node,browser}.ts",
        "src/**/*.test.ts",
        "src/scripts/*.ts",
        "docs/src/demo/main.ts",
        "docs/snippets/*.ts",
        "docs/src/content/docs/**/*.mdx",
        "docs/src/components/*.astro",
        "docs/astro.config.mjs",
        "docs/src/content.config.ts"
      ],
      "project": [
        "src/**/*.ts",
        "docs/**/*.ts",
        "docs/**/*.astro",
        "docs/**/*.mdx",
        "docs/**/*.mjs",
        "!docs/checker/**"
      ],
      "ignoreDependencies": ["@astrojs/check"]
    },
    "docs/checker": {
      "entry": [],
      "project": ["*.mjs"]
    }
  }
}
