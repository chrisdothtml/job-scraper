{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/index.ts",
    "src/**/*.test.ts",
    "site/main.ts",
    "site/build.ts",
    "site/snippets/*.ts"
  ],
  "project": ["src/**/*.ts", "site/**/*.ts"],
  "yarn": true,
  "ignoreExportsUsedInFile": true,
  "tags": ["-@knipignore"]
}
