{
  "name": "@chrisdothtml/job-scraper",
  "version": "0.1.1",
  "description": "A collection of job board scrapers, plus utilities that resolve a scraper for a company on the fly",
  "keywords": [
    "jobs",
    "scraper",
    "ats",
    "greenhouse",
    "ashby",
    "lever",
    "workday"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisdothtml/job-scraper.git"
  },
  "type": "module",
  "packageManager": "bun@1.4.2",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#platform": {
      "job-scraper-source": {
        "node": "./src/platform/node.ts",
        "default": "./src/platform/browser.ts"
      },
      "node": "./dist/platform/node.js",
      "default": "./dist/platform/browser.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "// checks": "----------------------------",
    "lint": "prettier --check .",
    "lint-fix": "prettier --write . | grep -v ' (unchanged)' || true",
    "test": "bun test --isolate --conditions=job-scraper-source",
    "typecheck": "tsc --noEmit && tsc --noEmit -p site",
    "// build": "-----------------------------",
    "bake-version": "bun src/scripts/bakeVersion.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun run bake-version",
    "prepack": "bun run build",
    "// site": "------------------------------",
    "site:build": "bun --conditions=job-scraper-source site/build.ts",
    "site:dev": "bun --conditions=job-scraper-source site/build.ts --dev"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^22.18.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.8.2",
    "prettier-plugin-sh": "^0.18.0",
    "typescript": "^7.0.2"
  }
}
