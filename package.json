{
  "name": "@chrisdothtml/job-scraper",
  "version": "0.2.0",
  "description": "A collection of job board scrapers, plus utilities that resolve a scraper for a company on the fly",
  "keywords": [
    "jobs",
    "scraper",
    "ats",
    "greenhouse",
    "ashby",
    "lever",
    "workday"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisdothtml/job-scraper.git"
  },
  "type": "module",
  "packageManager": "bun@1.4.2",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#platform": {
      "job-scraper-source": {
        "node": "./src/platform/node.ts",
        "default": "./src/platform/browser.ts"
      },
      "node": "./dist/platform/node.js",
      "default": "./dist/platform/browser.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "bin": {
    "job-scraper": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "skills/job-scraper"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "cli": "bun src/cli/index.ts",
    "// checks": "----------------------------",
    "lint": "prettier --check .",
    "lint-fix": "prettier --write . | grep -v ' (unchanged)' || true",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro sync --root docs && tsc --noEmit && tsc --noEmit -p docs && bun run --cwd docs/checker check",
    "knip": "knip",
    "static-checks": "bun run --parallel lint typecheck knip",
    "// tests": "----------------------------",
    "test": "bun test --isolate --conditions=job-scraper-source",
    "check-boards": "bun --conditions=job-scraper-source src/scripts/checkBoards.ts",
    "ci": "bun run --parallel static-checks test build docs:build",
    "// build": "-----------------------------",
    "bake-version": "bun src/scripts/bakeVersion.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun run bake-version && chmod +x dist/cli/index.js",
    "prepack": "bun run build",
    "// docs": "------------------------------",
    "docs:build": "ASTRO_TELEMETRY_DISABLED=1 astro build --root docs && bun --conditions=job-scraper-source docs/check.ts",
    "docs:dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --root docs --ignore-lock",
    "docs:preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --root docs --ignore-lock"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/starlight": "^0.42.5",
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.18.0",
    "astro": "^7.3.7",
    "knip": "^6.40.0",
    "prettier": "^3.8.2",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-sh": "^0.18.0",
    "satori": "^0.33.0",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "docs/checker"
  ]
}
