{
  "name": "@chrisdothtml/job-scraper",
  "version": "0.0.1",
  "description": "A collection of job board scrapers, plus utilities that resolve a scraper for a company on the fly",
  "keywords": [
    "jobs",
    "scraper",
    "ats",
    "greenhouse",
    "ashby",
    "lever",
    "workday"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisdothtml/job-scraper.git"
  },
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "// checks": "----------------------------",
    "lint": "prettier --check .",
    "lint-fix": "prettier --write . | grep -v ' (unchanged)'",
    "test": "./bin/tsn --test './src/__tests__/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "// build": "-----------------------------",
    "bake-version": "./bin/tsn -e \"const {_bakeVersion:fn} = await import('./src/constants.ts');fn()\"",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && yarn bake-version",
    "prepack": "yarn build"
  },
  "volta": {
    "node": "25.2.1",
    "yarn": "4.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "prettier": "^3.6.2",
    "prettier-plugin-sh": "^0.18.0",
    "typescript": "^5.9.2"
  }
}
