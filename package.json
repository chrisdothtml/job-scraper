{
  "name": "@chrisdothtml/job-scraper",
  "version": "0.1.1",
  "description": "A collection of job board scrapers, plus utilities that resolve a scraper for a company on the fly",
  "keywords": [
    "jobs",
    "scraper",
    "ats",
    "greenhouse",
    "ashby",
    "lever",
    "workday"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisdothtml/job-scraper.git"
  },
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#platform": {
      "job-scraper-source": {
        "node": "./src/platform/node.ts",
        "default": "./src/platform/browser.ts"
      },
      "node": "./dist/platform/node.js",
      "default": "./dist/platform/browser.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "// checks": "----------------------------",
    "lint": "prettier --check .",
    "lint-fix": "prettier --write . | grep -v ' (unchanged)'",
    "test": "./bin/tsn --test './src/__tests__/**/*.test.ts'",
    "typecheck": "tsc --noEmit && tsc --noEmit -p site",
    "// build": "-----------------------------",
    "bake-version": "./bin/tsn src/scripts/bakeVersion.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && yarn bake-version",
    "prepack": "yarn build",
    "// site": "------------------------------",
    "site:build": "./bin/tsn site/build.ts",
    "site:dev": "./bin/tsn site/build.ts --dev"
  },
  "volta": {
    "node": "25.2.1",
    "yarn": "4.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.6.2",
    "prettier-plugin-sh": "^0.18.0",
    "typescript": "^5.9.2"
  }
}
