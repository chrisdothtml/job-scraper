{
  // The site runs in browsers, so it gets the DOM lib; the library itself
  // doesn't, which keeps it from leaning on browser-only globals
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "lib": ["esnext", "dom", "dom.iterable"],
    // the docs' snippets import the package by name, as readers would
    "paths": { "@chrisdothtml/job-scraper": ["../src/index.ts"] }
  },
  "include": ["./**/*"],
  "exclude": []
}
